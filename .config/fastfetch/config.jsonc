{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    // Title
    {
      "type": "title",
      "format": "{#1}╭───────────── {#}{host-name-colored}"
    },
    // System Information
    {
      "type": "custom",
      "format": "{#1}│ {#}System Information"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 OS"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "initsystem",
      "key": "{#separator}│  {#keys} Init System"
    },
    {
      "type": "sound",
      "key": "{#separator}│  {#keys} Sound",
      "format": "{platform-api}"
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏖 Packages"
      //"format": "{all}"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys} OS Birthday",
      "text": "birth_install=$(stat -c %W /); echo $(date -d @$birth_install '+%d %b %Y')"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󱦟 OS Age",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    // Desktop Environment
    {
      "type": "custom",
      "format": "{#1}│ {#}Desktop Environment"
    },
    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨 DE"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬 WM"
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼 WM Theme"
    },
    {
      "type": "lm",
      "key": "{#separator}│  {#keys}󰍂 LM"
    },
    {
      "type": "theme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "icons",
      "key": "{#separator}│  {#keys} Icons"
    },
    {
      "type": "font",
      "key": "{#separator}│  {#keys} Font"
    },
    {
      "type": "display",
      "key": "{#separator}│  {#keys}󰹑 Display"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "terminal",
      "key": "{#separator}│  {#keys} Terminal"
    },
    {
      "type": "terminalfont",
      "key": "{#separator}│  {#keys}󰛖 Terminal Font"
    },
    {
      "type": "locale",
      "key": "{#separator}│  {#keys}  Locale"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    // Hardware Information
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware Information"
    },
    {
      "type": "chassis",
      "key": "{#separator}│  {#keys}󰌢 Chassis",
      "format": "Laptop {vendor}"
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󱁋 Disk (/)",
      "folders": "/"
    },
    {
      "type": "physicaldisk",
      "key": "{#separator}│  {#keys}󰋊 Physical Disk ({name})",
      "temp": true
    },
    {
      "type": "bios",
      "key": "{#separator}│  {#keys}󰘚 Bios ({type})",
      "format": "{version} ({release})"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    // Colors
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },
    // Footer
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────╯"
    }
  ]
}
